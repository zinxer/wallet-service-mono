# Copy to config/.env (loaded by config/run_config.js). Placeholders only.
# Every DEV_* variable has a PROD_* twin; the run argument (dev|prod) picks the set.
BRAND_NAME=Wallet Service
EMAIL_FROM_ADDRESS=noreply@example.com
# Only for lib/tests/ipn_listener.js
IPN_TEST_MERCHANT_ID=
IPN_TEST_API_KEY=
IPN_TEST_API_SECRET=

DEV_MAIN_URL=http://localhost:3000
DEV_MAIN_DOMAIN=http://localhost:3000
DEV_MAIN_PORT=3000
DEV_PREFIX=/v1
DEV_DB_SCHEMA=wallet_service
DEV_DB_HOST=localhost
DEV_DB_USER=changeme
DEV_DB_PASSWORD=changeme
DEV_DB_SSL_CA_PATH=
DEV_USDT_NODE_NETWORK=testnet
DEV_USDT_NODE_HOST=127.0.0.1
DEV_USDT_NODE_PORT=8332
DEV_USDT_NODE_USER=changeme
DEV_USDT_NODE_PASSWORD=changeme
DEV_ETH_NODE_NETWORK=ropsten
DEV_WALLET_ADDR_FUNDER=<btc-funder-address>
DEV_WALLET_ADDR_WITHDRAW=<btc-withdraw-address>
DEV_WALLET_ADDR_DESTADDR=<btc-destination-address>
DEV_ETH_WALLET_ADDR_WITHDRAW=0x0000000000000000000000000000000000000000
DEV_ETH_WALLET_ADDR_COLD=0x0000000000000000000000000000000000000000
DEV_ETH_WALLET_PASSWORD=changeme
DEV_CMC_CRED=changeme
DEV_EMAIL_2FA_HOST=smtp.example.com
DEV_EMAIL_2FA_PORT=587
DEV_EMAIL_2FA_PASSWORD=changeme
DEV_EMAIL_VERILINK_HOST=smtp.example.com
DEV_EMAIL_VERILINK_PORT=587
DEV_EMAIL_VERILINK_PASSWORD=changeme
DEV_EMAIL_PASSRESET_HOST=smtp.example.com
DEV_EMAIL_PASSRESET_PORT=587
DEV_EMAIL_PASSRESET_PASSWORD=changeme
DEV_ENDPOINTS_SECRET=changeme
DEV_TELEGRAM_KEY=changeme
DEV_TELEGRAM_GROUP_SYSTEM=<chat-id>
DEV_TELEGRAM_GROUP_MONITOR=<chat-id>
DEV_TELEGRAM_GROUP_ADMIN=<chat-id>
DEV_ETHERSCAN_APIKEY=changeme
DEV_IPDATA_APIKEY=changeme
DEV_AWS_APIKEY=changeme
DEV_AWS_SECRETKEY=changeme
DEV_AWS_BUCKET_NAME=example-dev-bucket
DEV_AES_KEY=changeme
